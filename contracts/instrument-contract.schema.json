{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CITY-INSTRUMENT-CONTRACT/1.0",
  "title": "Mathematical City instrument contract",
  "type": "object",
  "required": ["schema","id","display_name","version","kind","maturity","evidence","entrypoint","smoke","provenance","telemetry","boundaries"],
  "properties": {
    "schema": {"const": "CITY-INSTRUMENT-CONTRACT/1.0"},
    "id": {"type": "string", "minLength": 2},
    "display_name": {"type": "string", "minLength": 2},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "kind": {"type": "string"},
    "maturity": {"enum": ["validated-core","research","experimental","prototype","archived"]},
    "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum":["E0","E1","E2","E3","E4","H0"]}},
    "entrypoint": {"type": "string"},
    "smoke": {
      "type": "object",
      "required": ["entrypoint","command","benchmark_command"],
      "properties": {
        "entrypoint": {"type": "string"},
        "command": {"type": "string"},
        "benchmark_command": {"type": "string"}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["receipt_schema","sources"],
      "properties": {
        "receipt_schema": {"const":"CITY-INSTRUMENT-RECEIPT/1.0"},
        "sources": {"type":"array","minItems":1,"items":{"type":"string"}}
      }
    },
    "telemetry": {
      "type":"object",
      "required":["failure_schema"],
      "properties":{"failure_schema":{"const":"CITY-INSTRUMENT-FAILURE/1.0"}}
    },
    "boundaries":{"type":"array","items":{"type":"string"}}
  }
}
