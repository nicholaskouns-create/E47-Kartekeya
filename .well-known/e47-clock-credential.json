{
  "schema": "https://nicholaskouns-create.github.io/clock-credential/v1",
  "repository": "nicholaskouns-create/E47-Kartekeya",
  "clock": {
    "repository": "nicholaskouns-create/Time",
    "mode": "external-tick-provider",
    "required_fields": [
      "clock_id",
      "epoch",
      "tick",
      "observed_at_utc"
    ]
  },
  "credential": {
    "signature": "Ed25519",
    "digest": "SHA-256",
    "binding": [
      "repository",
      "commit_sha",
      "workflow_run_id",
      "nonce",
      "issued_at_utc",
      "expires_at_utc",
      "clock_id",
      "epoch",
      "tick"
    ],
    "verification": "signature+issuer-trust+expiry+nonce-replay-check+repository-commit-binding"
  },
  "status": "integration-manifest-only",
  "notes": "No private keys, tokens, or shared credentials are stored here. Tick is evidence, not authentication. Enforce trust and replay checks in a verifier."
}
